# Dominio canonico del sitio (sin barra final).
# Debe coincidir con el dominio donde se sirve la pagina: la auditoria
# encontro og:url en erp.assetbase.com.mx mientras el sitio respondia en
# erp.assetbase.org. Elige uno y redirige el otro con 301.
NEXT_PUBLIC_SITE_URL=https://erp.assetbase.com.mx


# ─────────────────────────────────────────────────────────────────────────
# Entrega de las solicitudes de demo
#
# Configura AL MENOS UNO de los dos bloques. Si no hay ninguno, /api/demo
# responde 503 a proposito, para que el visitante vea la salida por
# WhatsApp en lugar de creer que ya agendo.
#
# Si configuras los dos, se intenta por ambos y basta con que uno llegue:
# el correo avisa al momento y la hoja queda como registro consultable.
# ─────────────────────────────────────────────────────────────────────────

# ── Correo por Resend (https://resend.com) ──────────────────────────────
# El remitente TIENE que ser de un dominio verificado en Resend. El
# destinatario admite varios separados por coma. El reply-to del correo es
# el prospecto, asi que responder el correo es responderle a el.
RESEND_API_KEY=
DEMO_EMAIL_FROM=AssetBase <demos@assetbase.com.mx>
DEMO_EMAIL_TO=ventas@assetbase.com.mx

# ── Hoja de Google via Apps Script ──────────────────────────────────────
# El script y sus instrucciones estan en scripts/google-apps-script.gs.
# La URL es la que termina en /exec.
DEMO_WEBHOOK_URL=

# Secreto compartido. Un web app de Apps Script se publica como "cualquier
# usuario", asi que sin esto quien descubra la URL puede escribir filas.
# Tiene que ser identico a la propiedad TOKEN del proyecto de Apps Script.
DEMO_WEBHOOK_TOKEN=


# ─────────────────────────────────────────────────────────────────────────
# Analitica — Google Analytics 4
#
# Sin esta variable NO se carga nada: en local y en preview la pagina queda
# limpia y no se contaminan las metricas con trafico de desarrollo.
#
# GA4 usa cookies, asi que la banda de consentimiento aparece sola cuando
# esta variable existe. El consentimiento arranca denegado (Consent Mode
# v2) y solo se otorga cuando el visitante acepta.
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
